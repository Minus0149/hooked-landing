NEXT_PUBLIC_SITE_URL=https://hookedcue.com
NEXT_PUBLIC_APP_URL=https://app.hookedcue.com

# --- beta signups ---------------------------------------------------------
# With none of these set, submissions append to .data/beta-signups.jsonl next to
# the running server. That is fine for a VPS or `next start`, and USELESS on
# serverless, where the filesystem is discarded between requests — set the
# webhook there or you will silently lose every signup.
#
# Convex (recommended — same database as the app, survives any deploy):
#   1. cd ../web
#   2. $env:CONVEX_SELF_HOSTED_URL      = "https://convex.hookedcue.com"
#      $env:CONVEX_SELF_HOSTED_ADMIN_KEY = "<admin key from your convex server>"
#   3. npx convex env set BETA_INGEST_SECRET "<random 32 bytes>"
#   4. npx convex deploy
#   5. set the two vars below, using the same secret
# BETA_WEBHOOK_URL=https://cnx.hookedcue.com/beta
# BETA_WEBHOOK_SECRET=<the same random 32 bytes>

# Any other JSON POST endpoint works too (apps script, discord, make.com).
# When a webhook is set, the file is skipped and the receiver owns de-duplication.
# BETA_DATA_DIR=.data
