NEXT_PUBLIC_SITE_URL=https://hookedcue.com
NEXT_PUBLIC_APP_URL=https://app.hookedcue.com

# --- beta signups ---------------------------------------------------------
# Signups go to the app's backend at the URL in src/config/backend.ts (Convex
# Cloud). The only thing the host needs is the shared secret, which must equal
# the backend's BETA_INGEST_SECRET:
BETA_WEBHOOK_SECRET=<same value as the backend's BETA_INGEST_SECRET>
#
# Send them somewhere else instead (Apps Script, Discord, make.com):
# BETA_SINK_URL=https://...
#
# Keep them in .data/beta-signups.jsonl next to the server instead (dev, or a
# VPS with no backend). Useless on serverless, where the disk is discarded.
# BETA_LOCAL_FILE=1
# BETA_DATA_DIR=.data
